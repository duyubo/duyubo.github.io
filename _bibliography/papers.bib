@inproceedings{du2026fpn,
  abbr      = {NDSS},
  bibtex_show = {true},
  selected  = {true},
  title     = {Fast Pointer Nullification for Use-After-Free Prevention},
  author    = {Du, Yubo and Zhang, Youtao and Yang, Jun},
  booktitle = {Proceedings of the Network and Distributed System Security Symposium (NDSS)},
  year      = {2026},
  pdf       = {https://www.ndss-symposium.org/wp-content/uploads/2026-f753-paper.pdf},
  code      = {https://github.com/duyubo/Fast-Pointer-Nullification-NDSS-2026},
  abstract  = {FPN is a runtime defense that prevents use-after-free attacks in deployed C/C++ software by invalidating dangling pointers when a buffer is freed. It uses the locality of pointers to track them in groups, while a fine-grained label keeps protection exact. FPN reduces memory overhead from about 173% to about 8% and runtime overhead from about 56% to about 18% compared with the latest precise pointer-tracking defense.}
}

@inproceedings{du2024rtt,
  abbr      = {ICS},
  bibtex_show = {true},
  selected  = {true},
  title     = {{RTT-UAF}: Reuse Time Tracking for Use-After-Free Detection},
  author    = {Du, Yubo and Guo, Yanan and Zhang, Youtao and Yang, Jun},
  booktitle = {Proceedings of the 38th ACM International Conference on Supercomputing (ICS)},
  pages     = {376--387},
  year      = {2024},
  doi       = {10.1145/3650200.3656606},
  html      = {https://doi.org/10.1145/3650200.3656606},
  abstract  = {RTT is a key-and-lock sanitizer that uses the number of times an address has been reused as the identifier of a buffer. The identifier fits in the unused upper bits of a pointer, so no metadata needs to be propagated. RTT reduces runtime overhead by up to 7x and memory overhead from more than 100% to under 8%, with the same detection rate on real-world use-after-free vulnerabilities.}
}

